# =============================================================================
# MySQL 8.0 自定义配置
# =============================================================================

[mysqld]
# socket/pid-file 显式指定：CI DinD 场景下宿主机 AppArmor 的 usr.sbin.mysqld
# profile 会附加到容器内 mysqld 进程，导致 /etc/my.cnf 读取被拒（EACCES），
# socket 会落到编译默认 /var/lib/mysql/mysql.sock，
# 与客户端期望的 /var/run/mysqld/mysqld.sock 不一致，健康检查失败。
# 本文件挂载到 /etc/mysql/my.cnf（profile 允许读 /etc/mysql/**）。
# 由于镜像自带 /etc/my.cnf 在该场景下不可读，其原有指令在此同步保留：
socket=/var/run/mysqld/mysqld.sock
pid-file=/var/run/mysqld/mysqld.pid
datadir=/var/lib/mysql
user=mysql
secure-file-priv=/var/lib/mysql-files
# 关闭反向 DNS：CI 网络内 DNS 超时会导致每个新 TCP 连接卡顿数秒
skip-name-resolve
skip-host-cache

# 字符集设置
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# 时区设置
default-time-zone='+08:00'

# SQL 模式（放宽限制以兼容旧版应用）
sql_mode=STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO

# 连接配置
max_connections=200
max_connect_errors=100

# 缓冲区设置
innodb_buffer_pool_size=256M
key_buffer_size=16M
table_open_cache=200

# 日志配置（使用 Docker 默认路径）
slow_query_log=1
slow_query_log_file=/var/lib/mysql/slow-query.log
long_query_time=2

# 二进制日志（可选，用于数据恢复和主从复制）
# log_bin=/var/log/mysql/mysql-bin.log
# expire_logs_days=7
# max_binlog_size=100M

[client]
default-character-set=utf8mb4
socket=/var/run/mysqld/mysqld.sock

[mysql]
default-character-set=utf8mb4
